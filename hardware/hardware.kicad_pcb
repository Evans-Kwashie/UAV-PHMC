	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(general
		(thickness 1.6)
		(legacy_teardrops no)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal "Front")
		(4 "In1.Cu" power "GND")
		(6 "In2.Cu" power "POWER")
		(2 "B.Cu" signal "Back")
		(13 "F.Paste" user)
		(15 "B.Paste" user)
