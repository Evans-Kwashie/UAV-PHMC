{
  "version": 3,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host unit tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-Wall -Wextra -Werror"
      }
    },
    {
      "name": "stm32-debug",
      "displayName": "STM32G071 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/stm32-debug",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "stm32-release",
      "displayName": "STM32G071 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/stm32-release",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "stm32-debug", "configurePreset": "stm32-debug" },
    { "name": "stm32-release", "configurePreset": "stm32-release" }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": { "outputOnFailure": true }
    }
  ]
}
